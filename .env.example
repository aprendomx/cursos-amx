# ===========================================================================
# Frontend (Vite) — .env de la raíz
# ===========================================================================
# Usado por la app Vue en `npm run dev` y `npm run build`. NO confundir con
# `docker/.env` (que configura el stack Supabase + worker en producción).
# ===========================================================================

VITE_SUPABASE_URL=https://api.tu-dominio.org
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Feature flags de módulos LMS ──
# ESTOS VALORES SON SOLO EL DEFAULT DE ARRANQUE. La fuente de verdad es la
# tabla `feature_toggles`: los módulos se encienden y apagan desde
# Administración → Módulos, sin reconstruir ni redesplegar.
# Tabla completa (31 claves, cuáles cierran datos): THEMING.md §5.
VITE_FEATURE_INSTRUCTOR=true

# Interacción
VITE_FEATURE_FOROS=false
VITE_FEATURE_CHAT=false
VITE_FEATURE_ENTREGAS=false
VITE_FEATURE_ENTREGAS_RUBRICAS=false

# Aulas virtuales
VITE_FEATURE_AULAS=false
VITE_FEATURE_SESIONES_VIRTUALES=false
VITE_FEATURE_ZOOM_INTEGRATION=false
VITE_FEATURE_SESIONES_GRABACIONES=false
VITE_FEATURE_TRANSCRIPCION_WHISPER=false

# Evaluación
VITE_FEATURE_EVALUACIONES=false

# Seguimiento
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_VIDEO_ANALYTICS=false
VITE_FEATURE_VIDEO_ANALYTICS_HEATMAP=false
VITE_FEATURE_REPORTES_AVANZADOS=false
VITE_FEATURE_GAMIFICACION=false

# Notificaciones
VITE_FEATURE_NOTIFICACIONES=false
VITE_FEATURE_NOTIFICACIONES_EMAIL=false
VITE_FEATURE_PUSH_NOTIFICATIONS=false

# Sin conexión (PWA)
VITE_FEATURE_PWA_OFFLINE=false
VITE_FEATURE_OFFLINE_VIDEO_CACHE=false
VITE_FEATURE_OFFLINE_SYNC=false

# Inteligencia artificial
VITE_FEATURE_AI_QUIZ=false
VITE_FEATURE_AI_SUMMARIES=false
VITE_FEATURE_AI_CHAT=false

# Instancia de Jitsi para las aulas virtuales (sin https://).
# Default: la instancia pública meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si

# Sentry error tracking (optional)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Transcripción (Whisper) ──
# URL del servicio faster-whisper local (default). Comenta para usar OpenAI directamente.
WHISPER_SERVICE_URL=http://whisper-service:5000
# Fallback a OpenAI si faster-whisper no responde (opcional)
OPENAI_API_KEY=

# Configuración del servicio faster-whisper (solo si usas docker-compose)
WHISPER_MODEL=medium       # tiny, base, small, medium, large-v2, distil-large-v3
WHISPER_DEVICE=cpu         # cpu | cuda
WHISPER_COMPUTE_TYPE=int8  # int8 (cpu), float16 (cuda), float32
WHISPER_PORT=5000
WHISPER_MEMORY_LIMIT=4G
